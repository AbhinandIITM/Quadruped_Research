  <gazebo reference="FR4">
    <mu1>200.0</mu1>      <mu2>200.0</mu2>      <minDepth>0.0002</minDepth>
    <kp value="10000.0"/> <kd value="2000.0"/>
  </gazebo>

  <gazebo reference="FL4">
    <mu1>200.0</mu1>
    <mu2>200.0</mu2>
    <minDepth>0.0002</minDepth>
