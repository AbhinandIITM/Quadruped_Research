<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">

  <xacro:property name="effort_limit" value="30.0"/>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.00048043 9.0814E-05 0.00023409" rpy="0 0 0"/>
      <mass value="0.81776"/>
      <inertia ixx="0.001" ixy="-1.0045E-06" ixz="1.0886E-08" iyy="0.001" iyz="3.2027E-08" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/body_obj.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
      	<box size="0.25 0.1285 0.055"/>
      </geometry>
    </collision>
  </link>
  <link name="imu_link">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="FR1">
    <inertial>
      <origin xyz="0.011092 -0.0032719 0.00019267" rpy="0 0 0"/>
      <mass value="0.15379"/>
      <inertia ixx="0.001" ixy="-1.0746E-05" ixz="-0.001" iyy="0.001" iyz="-0.001" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/FR1_obj.obj"/>
      </geometry>
    </visual>
  </link>

