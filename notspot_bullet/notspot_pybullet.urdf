  <joint name="RR2_joint" type="revolute">
    <origin xyz="0.0469 0 0" rpy="1.5708 0 -1.5708"/>
    <parent link="RR1"/>
    <child link="RR2"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3" upper="3" effort="${effort_limit}" velocity="3"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <joint name="RR3_joint" type="revolute">
