    <parent link="RR3"/>
    <child link="RR4"/>
    <axis xyz="0 0 0"/>
  </joint>

  <joint name="RL1_joint" type="revolute">
    <origin xyz="-0.0954 0.04 0" rpy="1.5708 0 -1.5708"/>
    <parent link="base_link"/>
    <child link="RL1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3" upper="3" effort="${effort_limit}" velocity="3"/>
    <dynamics damping="0.5" friction="0.1"/>
