# =============================================================================
# OmniRoute / OpenAI-Compatible Model Gateway Configuration
# =============================================================================
# URL where your OmniRoute proxy is running (default: http://localhost:20128/v1 or from ANTHROPIC_BASE_URL)
OMNIROUTE_BASE_URL=http://localhost:20128/v1
# Model name connected inside OmniRoute (e.g., gemini_studio, deepseek-r1:8b, qwen2.5:7b)
OMNIROUTE_MODEL=gemini_studio
# API key if required by your OmniRoute setup (optional)
# OMNIROUTE_API_KEY=your_key_here

# =============================================================================
# Dedicated Model Server Configuration (start_model_server.py)
# =============================================================================
# Active backend: omniroute, ollama, gemini, or mock
MODEL_BACKEND=omniroute
# Local microservice port (default: 5005)
MODEL_SERVER_PORT=5005

# =============================================================================
# Google AI Studio / Gemini API Key
# =============================================================================
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# =============================================================================
# Ollama Configuration
# =============================================================================
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=deepseek-r1:8b

